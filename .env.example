# Authentication
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OUTREACH_SENDER_NAME=Your first name
# Google account that inherits the data created before workspaces existed.
# Set it once before the first deploy with workspaces; it can only be claimed once.
LEGACY_DATA_OWNER_EMAIL=

# Turso / Drizzle
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# Lead discovery
GOOGLE_PLACES_API_KEY=
# Estimated cost per Places search, expressed in the campaign budget's minor unit.
GOOGLE_PLACES_ESTIMATED_REQUEST_MINOR=0
# Per-workspace daily caps that protect your API bill while sign-ups are open.
PLACES_DAILY_SEARCH_LIMIT=5
AUDIT_DAILY_LIMIT=40

# Public website and business-profile discovery
BRAVE_SEARCH_API_KEY=
# Per workspace per day.
BRAVE_DAILY_LIMIT=30

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per workspace per day.
GEMINI_DAILY_LIMIT=30

# Vercel cron authentication
CRON_SECRET=replace-with-a-different-long-random-string

# Local UI preview only. Keep false in Vercel.
DEMO_MODE=false
